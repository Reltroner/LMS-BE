  "outbox_inbox": {
    "outbox": {
      "required": "domain write and event outbox INSERT within same owner DB transaction",
      "publication": "async at-least-once after commit; delivery via Redis 8 transient",
      "retry": "bounded exponential backoff, retry budget and dead-letter incident policy pending measured ADR",
      "crash_consistency": "if crash occurs after local commit before broker publish, persisted outbox is replayable"
    },
    "inbox": {
      "deduplication_key": "source_service + event_id + event_version",
      "commit": "consumer side effects and inbox receipt in one local owned DB transaction",
      "reorder": "aggregate version/monotonic checkpoint or deliberate compensating path; never silent regress"
    },
    "no_distributed_transaction": true,
    "no_redis_only_correctness": true
  },
  "booking": {
    "slot_occupancy": "database transaction and unique constraint independent of transport/idempotency",
    "idempotency": "durable key scope+fingerprint+result retained, key collision mismatched payload -> 409",
    "replay": "repeated same key+payload returns stable prior result and does not reserve twice",
    "temporal_columns": "TZ/precision candidate pending provider acceptance"
  },
  "admin_role": {
    "intent": "Audit service records durable requested mutation before external Keycloak adapter action",
    "adapter": "Keycloak is sole role authority; no direct LMS identity DB",
    "reconcile": [
      "INTENT_RECORDED",
      "KEYCLOAK_APPLIED",
      "AUDIT_CONFIRMED",
      "FAILED_RETRYABLE",
      "ESCALATE_MANUAL"
    ],
    "outcome": "nonatomic cross-system; explicit idempotent retry, never claim atomic Keycloak+DB",
    "phase4_gate": "requires signed protocol and live failure tests before role PATCH"
  },
  "prohibited": [
    "cross-service DB connections",
    "cross-DB writes",
    "global two-phase commit",
    "Redis only loss-prone correctness",
    "production migration from this artifact",
    "seventh owner database",
    "immutable audit log updates"
  ],
  "implementation_status": "CONTRACTS_AND_NEGATIVE_MODEL_ONLY"
}
